{
  "id": "hello.javascript",
  "name": "Hello (JavaScript)",
  "version": "0.2.0",
  "description": "Reference plugin: proves the Node.js runtime and the JavaScript SDK work end to end.",
  "runtime": {
    "type": "javascript",
    "entry": "plugin.js",
    "runtime": "node",
    "min_version": "18"
  },
  "capabilities": [
    "llm.generate"
  ],
  "timeout_seconds": 60,
  "input": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "default": "world",
        "maxLength": 200
      },
      "use_llm": {
        "type": "boolean",
        "default": false
      }
    }
  },
  "output": {
    "type": "object",
    "required": [
      "greeting",
      "runtime"
    ],
    "properties": {
      "greeting": {
        "type": "string"
      },
      "runtime": {
        "type": "string"
      },
      "node_version": {
        "type": "string"
      }
    }
  },
  "default_config": {
    "greeting_template": "Hello, {name}!",
    "use_llm": false
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "greeting_template": {
        "type": "string"
      },
      "use_llm": {
        "type": "boolean"
      },
      "model": {
        "type": "string"
      }
    }
  },
  "models": {
    "text": "default"
  }
}
