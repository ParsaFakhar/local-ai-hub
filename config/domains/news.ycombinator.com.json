{"domain": "news.ycombinator.com", "label": "Hacker News (working demo site)", "features": {"comments.classify": {"enabled": true, "auto_run": false, "root_selector": "table.comment-tree", "item_selector": "tr.athing.comtr", "fields": {"text": {"selector": "div.commtext", "attr": "text"}, "author": {"selector": "a.hnuser", "attr": "text"}}, "input": {"comments": "@items", "page_title": "@page.title"}, "options": {"labels": ["ok", "spam", "toxic", "off-topic"], "batch_size": 6, "instructions": "Classify Hacker News comments. 'ok' = on-topic technical discussion, 'toxic' = personal attacks or hostility, 'off-topic' = unrelated to the story, 'spam' = promotion."}, "apply": {"results_path": "results", "match_by": "id", "actions": [{"action": "badge", "text": "{label}"}, {"action": "attribute", "name": "data-lah-label", "value": "{label}"}, {"action": "class", "map": {"toxic": "lah-flag-toxic", "spam": "lah-flag-spam", "off-topic": "lah-flag-offtopic"}}]}}}}